# Copy to .env and fill in YOUR values. start.sh sources this file and exports the
# vars; application.yml reads them via ${PLACEHOLDER} bindings. Nothing here is
# hardcoded in the app — every environment-specific value lives in .env (gitignored).

# --- Ports ---
SERVER_PORT=8899      # Spring Boot backend (also serves the bundled UI in prod)
FRONTEND_PORT=5173    # Vite dev server (dev mode only)

# --- HTTPS / TLS (optional; off by default → plain HTTP) ---
# Serve the UI + API over HTTPS. Generate a cert with:  ./scripts/gen-tls-cert.sh
# then set TLS_ENABLED=true. Paths are relative to the app's working directory; use a
# file: URL so Spring loads them from disk (not the classpath). See README → "HTTPS / TLS".
TLS_ENABLED=false
TLS_CERT=file:certs/cert.pem
TLS_KEY=file:certs/key.pem
LOG_LEVEL=INFO
SCHEDULING_POOL_SIZE=6   # one thread per scheduled task (inverter/consumption/energy-sampler/autopilot/miner/history)
# JVM heap/footprint cap for the 416 MB Raspberry Pi (~140 MB RSS; avoids OOM)
JAVA_OPTS='-Xmx128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=64m -Xss512k -XX:TieredStopAtLevel=1 -XX:-UsePerfData -Dreactor.netty.ioWorkerCount=2 -Dspring.main.lazy-initialization=true'

# --- Sungrow SG10RS / WiNet-S dongle (local WebSocket API, wss on 443) ---
# Supplies SOLAR GENERATION only — the inverter exposes no whole-home meter.
INVERTER_HOST=            # e.g. 192.168.1.50 — the dongle's LAN IP
INVERTER_PORT=443
INVERTER_WS_PATH=/ws/home/overview
INVERTER_USERNAME=        # WiNet local account (often "admin")
INVERTER_PASSWORD=        # WiNet local password
INVERTER_POLL_INTERVAL_MS=10000
INVERTER_REQUEST_TIMEOUT_MS=8000

# --- Solar Analytics cloud API (measured WHOLE-HOME consumption) ---
# The source of truth for house consumption, from their own CT hardware. Combined
# with inverter solar to compute the surplus that drives the autopilot.
SOLARANALYTICS_ENABLED=true
SOLARANALYTICS_HOST=https://portal.solaranalytics.com.au/api/v3
SOLARANALYTICS_USER=              # Solar Analytics account email
SOLARANALYTICS_PASSWORD=          # Solar Analytics account password
SOLARANALYTICS_SITE_ID=           # blank = auto-detect the first active site
SOLARANALYTICS_POLL_INTERVAL_MS=15000
SOLARANALYTICS_STALE_AFTER_SECONDS=60   # older readings are treated as unavailable
SOLARANALYTICS_REQUEST_TIMEOUT_MS=8000
# Only call the consumption API when the inverter is generating > this many watts.
# Below it there's no usable surplus, so skip the call (saves pointless API hits at night).
SOLARANALYTICS_MIN_SOLAR_W=800

# --- Braiins OS+ miner (Antminer S19k Pro, local GraphQL API) ---
MINER_ENABLED=true
MINER_HOST=            # e.g. 192.168.1.80 — the miner's LAN IP
MINER_POLL_INTERVAL_MS=10000
MINER_REQUEST_TIMEOUT_MS=8000
MINER_AUTH_TOKEN=      # blank unless the miner API requires a bearer token

# Miner hard power limits (W)
MINER_MIN_POWER_W=800
MINER_MAX_POWER_W=3600

# --- Smoothed solar-surplus autopilot (ladder-tracks the averaged surplus) ---
# OFF by default: it drives real mining hardware. Enable only once configured.
# Ladder = FLOOR_W .. MINER_MAX_POWER_W by STEP_W; ceiling is MINER_MAX_POWER_W.
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_MS=30000
AUTOPILOT_FLOOR_W=1200             # lowest run power; must be ≥ MINER_MIN_POWER_W. Below → stop
AUTOPILOT_STEP_W=400               # ladder rung spacing
AUTOPILOT_HEADROOM_W=200           # anti-import buffer (target ≤ surplus − headroom)
AUTOPILOT_START_SURPLUS_W=1600     # surplus to (re)start from off; must be > FLOOR_W (hysteresis)
AUTOPILOT_UP_MAX_RUNGS=2           # rungs a single up-move may climb
AUTOPILOT_EMERGENCY_GAP_W=800      # over-draw that bypasses the down interval (fast protection)
AUTOPILOT_UP_INTERVAL_MS=900000    # dampening between up/start steps; must be ≥ LONG_WINDOW_MS
AUTOPILOT_DOWN_INTERVAL_MS=300000  # between routine down steps; must be ≥ SHORT_WINDOW_MS
AUTOPILOT_SHORT_WINDOW_MS=180000   # averaging window for down/stop (fast reaction)
AUTOPILOT_LONG_WINDOW_MS=900000    # averaging window for up/start (conservative)
AUTOPILOT_MIN_RUN_MS=180000        # once mining, don't stop for this long unless importing hard
AUTOPILOT_FRESH_WITHIN_MS=90000    # a feed with no sample newer than this → surplus unknown
AUTOPILOT_SHORT_COVERAGE_MS=60000  # min span a short window must cover to be trusted
AUTOPILOT_LONG_COVERAGE_MS=300000  # min span a long window must cover to be trusted

# --- Telemetry history (powers the UI trend chart) ---
# Tiny file-backed store: append-only day-files, at most RETENTION_DAYS kept (older discarded).
HISTORY_ENABLED=true
HISTORY_DIR=data/history            # created if absent; relative to the working directory
HISTORY_RECORD_INTERVAL_MS=60000    # one sample per minute (~43k rows/month)
HISTORY_RETENTION_DAYS=31           # keep ~1 month, then discard

# --- Access control (every /api/** endpoint requires this password) ---
AUTH_ENABLED=true
# bcrypt hash of the UI password. Generate one (note the single quotes — the hash
# contains '$', which the shell would otherwise expand):
#   AUTH_PASSWORD_HASH="$(htpasswd -bnBC 10 '' 'yourpassword' | tr -d ':\n')"
# then paste it below, single-quoted. Blank ⇒ fail-closed (all requests rejected).
AUTH_PASSWORD_HASH=
AUTH_TOKEN_TTL_DAYS=30    # how long the UI stays logged in (token lifetime, days)

# --- Deploy target for deploy.sh (optional; only needed to deploy over SSH) ---
DEPLOY_HOST=            # remote host/IP
DEPLOY_PORT=22
DEPLOY_USER=            # remote SSH user
DEPLOY_KEY=             # path to the SSH private key, e.g. ./deploy_key.pem
