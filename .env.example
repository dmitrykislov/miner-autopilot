# Copy to .env and fill in YOUR values. start.sh sources this file and exports the
# vars; application.yml reads them via ${PLACEHOLDER} bindings. Nothing here is
# hardcoded in the app — every environment-specific value lives in .env (gitignored).

# --- Ports ---
SERVER_PORT=8899      # Spring Boot backend (also serves the bundled UI in prod)
FRONTEND_PORT=5173    # Vite dev server (dev mode only)
LOG_LEVEL=INFO
SCHEDULING_POOL_SIZE=3

# --- Sungrow SG10RS / WiNet-S dongle (local WebSocket API, wss on 443) ---
INVERTER_HOST=            # e.g. 192.168.1.50 — the dongle's LAN IP
INVERTER_PORT=443
INVERTER_WS_PATH=/ws/home/overview
INVERTER_USERNAME=        # WiNet local account (often "admin")
INVERTER_PASSWORD=        # WiNet local password
INVERTER_POLL_INTERVAL_MS=10000
INVERTER_REQUEST_TIMEOUT_MS=8000

# --- Powersensor gateway (measured whole-home consumption, local UDP API) ---
POWERSENSOR_ENABLED=true
POWERSENSOR_HOST=         # e.g. 192.168.1.60 — the gateway's LAN IP
POWERSENSOR_PORT=49476
POWERSENSOR_SUBSCRIBE_LIFETIME_SECONDS=180
POWERSENSOR_RESUBSCRIBE_INTERVAL_SECONDS=90
POWERSENSOR_STALE_AFTER_SECONDS=30
POWERSENSOR_CLAMP_MAC=    # blank = auto-detect the mains clamp (it reports no voltage)
HOUSE_ASSUMED_LOAD_KW=0.5

# --- TP-Link Tapo P110 smart plug (disabled: runs unsupported TPAP locally) ---
PLUG_ENABLED=false
PLUG_HOST=               # e.g. 192.168.1.70 — the plug's LAN IP
# TP-Link/Tapo ACCOUNT credentials (the plug has no device-local password)
PLUG_EMAIL=
PLUG_PASSWORD=
PLUG_NAME=               # optional friendly name; blank = use the device nickname
PLUG_POLL_INTERVAL_MS=10000
PLUG_REQUEST_TIMEOUT_MS=8000
PLUG_MODE=cloud          # "cloud" (TP-Link cloud relay) or "local" (on-LAN KLAP)
PLUG_MAC=                # blank = match the first P110 in the account device list
PLUG_CLOUD_BASE_URL=https://wap.tplinkcloud.com

# --- Braiins OS+ miner (Antminer S19k Pro, local GraphQL API) ---
MINER_ENABLED=true
MINER_HOST=            # e.g. 192.168.1.80 — the miner's LAN IP
MINER_POLL_INTERVAL_MS=10000
MINER_REQUEST_TIMEOUT_MS=8000
MINER_AUTH_TOKEN=      # blank unless the miner API requires a bearer token

# Miner hard power limits (W)
MINER_MIN_POWER_W=800
MINER_MAX_POWER_W=3600

# --- Solar-margin autopilot (auto start/stop + step miner power) ---
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_MS=30000
AUTOPILOT_START_MARGIN_W=1000
AUTOPILOT_LOW_MARGIN_W=100
AUTOPILOT_STEP_W=1000
