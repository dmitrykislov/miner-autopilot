# Copy to .env and fill in YOUR values. start.sh sources this file and exports the
# vars; application.yml reads them via ${PLACEHOLDER} bindings. Nothing here is
# hardcoded in the app — every environment-specific value lives in .env (gitignored).

# --- Ports ---
SERVER_PORT=8899      # Spring Boot backend (also serves the bundled UI in prod)
FRONTEND_PORT=5173    # Vite dev server (dev mode only)
LOG_LEVEL=INFO
SCHEDULING_POOL_SIZE=4   # one thread per scheduled task (inverter/consumption/miner/autopilot)

# --- Sungrow SG10RS / WiNet-S dongle (local WebSocket API, wss on 443) ---
# Supplies SOLAR GENERATION only — the inverter exposes no whole-home meter.
INVERTER_HOST=            # e.g. 192.168.1.50 — the dongle's LAN IP
INVERTER_PORT=443
INVERTER_WS_PATH=/ws/home/overview
INVERTER_USERNAME=        # WiNet local account (often "admin")
INVERTER_PASSWORD=        # WiNet local password
INVERTER_POLL_INTERVAL_MS=10000
INVERTER_REQUEST_TIMEOUT_MS=8000

# --- Solar Analytics cloud API (measured WHOLE-HOME consumption) ---
# The source of truth for house consumption, from their own CT hardware. Combined
# with inverter solar to compute the surplus that drives the autopilot.
SOLARANALYTICS_ENABLED=true
SOLARANALYTICS_HOST=https://portal.solaranalytics.com.au/api/v3
SOLARANALYTICS_USER=              # Solar Analytics account email
SOLARANALYTICS_PASSWORD=          # Solar Analytics account password
SOLARANALYTICS_SITE_ID=           # blank = auto-detect the first active site
SOLARANALYTICS_POLL_INTERVAL_MS=15000
SOLARANALYTICS_STALE_AFTER_SECONDS=60   # older readings are treated as unavailable
SOLARANALYTICS_REQUEST_TIMEOUT_MS=8000
# Only call the consumption API when the inverter is generating > this many watts.
# Below it there's no usable surplus, so skip the call (saves pointless API hits at night).
SOLARANALYTICS_MIN_SOLAR_W=800

# --- Braiins OS+ miner (Antminer S19k Pro, local GraphQL API) ---
MINER_ENABLED=true
MINER_HOST=            # e.g. 192.168.1.80 — the miner's LAN IP
MINER_POLL_INTERVAL_MS=10000
MINER_REQUEST_TIMEOUT_MS=8000
MINER_AUTH_TOKEN=      # blank unless the miner API requires a bearer token

# Miner hard power limits (W)
MINER_MIN_POWER_W=800
MINER_MAX_POWER_W=3600

# --- Solar-margin autopilot (auto start/stop + step miner power) ---
# OFF by default: it drives real mining hardware. Enable only once configured.
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_MS=30000
AUTOPILOT_START_MARGIN_W=1000   # must be ≥ MINER_MIN_POWER_W and ≥ AUTOPILOT_STEP_W
AUTOPILOT_LOW_MARGIN_W=100
AUTOPILOT_STEP_W=800     # deadzone (start-low=900) must be ≥ step, else it oscillates

# --- Deploy target for deploy.sh (optional; only needed to deploy over SSH) ---
DEPLOY_HOST=            # remote host/IP
DEPLOY_PORT=22
DEPLOY_USER=            # remote SSH user
DEPLOY_KEY=             # path to the SSH private key, e.g. ./deploy_key.pem
